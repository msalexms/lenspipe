{
  "name": "iphone-camera-link",
  "version": "1.0.0",
  "description": "Use an iPhone as a low-latency studio camera on your PC and in OBS, over USB or Wi-Fi. Local only: WebCodecs + WebSockets, no app, no cloud.",
  "license": "MIT",
  "author": "AMSTech",
  "keywords": [
    "iphone",
    "webcam",
    "obs",
    "webcodecs",
    "websocket",
    "h264",
    "hevc",
    "streaming",
    "local"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite build --watch\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test:relay": "node scripts/smoke-relay.mjs",
    "test:receiver": "tsx scripts/test-receiver.ts",
    "test:health": "tsx scripts/test-health.ts",
    "test:sps": "tsx scripts/test-h264-sps.ts",
    "measure:pc": "node scripts/measure-pc.mjs",
    "test:audio": "node scripts/test-audio.mjs",
    "test:pairing": "tsx scripts/test-pairing.ts",
    "test": "npm run test:receiver && npm run test:sps && npm run test:health && npm run test:pairing && npm run test:orientation && npm run test:formats",
    "test:ui": "node scripts/check-ui.mjs",
    "screenshots": "node scripts/check-ui.mjs --docs",
    "test:orientation": "tsx scripts/test-orientation.ts",
    "test:formats": "tsx scripts/test-formats.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/dom-webcodecs": "^0.1.11",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/selfsigned": "^2.0.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
