{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LensPipe",
  "version": "1.0.0",
  "identifier": "dev.amstech.lenspipe",
  "build": {
    "beforeDevCommand": "npm run build && npm run build:sidecar",
    "beforeBuildCommand": "npm run build && npm run build:sidecar",
    "frontendDist": "./splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LensPipe · Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/lenspipe-server"
    ],
    "resources": {
      "../dist/": "web/"
    },
    "publisher": "AMSTech",
    "category": "Video",
    "shortDescription": "Turn any phone into a low-latency studio camera for PC & OBS",
    "longDescription": "Stream your iPhone or Android camera to PC and OBS over USB or Wi-Fi using WebCodecs and binary WebSockets. No phone app, no cloud, local network only.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
